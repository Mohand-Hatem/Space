PORT=5000
NODE_ENV=development
APP_NAME=Space.App

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Space

# JWT Cryptography Secrets
JWT_SECRET=your_super_secret_access_key_string_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_string_2026
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Application Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com